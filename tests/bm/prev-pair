#!/usr/bin/env bash
# Usage: prev-pair LEDGER BENCH VARIANT
# Prints [fork_row, upstream_row] as JSON: the newest VARIANT row for BENCH
# that has an upstream row from the same run (same ts), or nothing if none
# does. Used by ./bm's fork/upstream ratio history gate. Rows written before
# ./bm used one timestamp per run can differ by a second; those are skipped
# rather than paired with a guess (review R10).
jq -sc --arg b "$2" --arg v "$3" '
	[.[] | select(.bench == $b)] as $r
	| [$r[] | select(.variant == "upstream") | .ts] as $uts
	| ([$r[] | select(.variant == $v and (.ts as $t | $uts | index($t) != null))] | last) as $f
	| if $f == null then empty else
		[$f, ([$r[] | select(.variant == "upstream" and .ts == $f.ts)] | last)]
	end' "$1" 2>/dev/null
