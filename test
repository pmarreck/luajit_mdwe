#!/usr/bin/env bash
# Full suite for the luajit_mdwe fork. Builds LuaJIT with upstream's Makefile
# and runs the MDWE characterization tests. Exit code = failure count (capped).
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fails=0
if ! make -s -C "$root/src" -j16 BUILDMODE=static >"$root/.build-work/make.log" 2>&1; then
	echo "LuaJIT build failed; see .build-work/make.log"; exit 1
fi
"$root/tests/mdwe/run" "$root/src/luajit" || fails=$((fails+1))
"$root/tests/upstream-suite" "$root/src/luajit" || fails=$((fails+1))
"$root/tests/compile/cross-targets" || fails=$((fails+1))
exit "$fails"
