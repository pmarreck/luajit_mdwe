# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	bench = Per-machine benchmark ledgers (ndjson), source-controlled
	bin/sizemcode-tune = Times a Lua script at several -Osizemcode sizes with -Omcoderemap=1; reports the fastest (--json, --match)
	bm = Fork vs pinned-upstream benchmark harness: output check, hyperfine, robust median/MAD ledger
	build = Build host product via build.zig into zig-out/<triple>/<profile>; publish bin/<os>/<arch>/luajit
	build-all = Cross-build the 5-target matrix via ./build
	build.zig = Zig build of LuaJIT mirroring src/Makefile config (lj_arch.h macro probe), host tools, generated headers, lib, CLI
	build.zig.zon = Zig package manifest (no dependencies)
	docs/LOCKDOWN_RESEARCH.md = Research record: executable-memory routes MDWE leaves open, neighbors (BEAMJIT, .NET 8), in-process lockdown limits; recommends not building it
	docs/MDWE_RESEARCH.md = MDWE research record: measurements, sources, precedents, backend inventory
	docs/MDWE_SPEC.md = Technical spec (design R: memfd MAP_FIXED remap) awaiting Grok review
	docs/UPSTREAM_CANDIDATES.md = Standalone fixes suitable for upstream LuaJIT submission, with evidence
	flake.nix = Pinned research dev shell (gcc, make, hyperfine, strace, gdb)
	test = Full suite: static LuaJIT build plus MDWE characterization
	tests/benchmark/layout-compare = Layout-controlled =1 vs =2 comparison across -falign-functions builds
	tests/bm/prev-pair = Pairs ./bm's previous fork row with the upstream row of the same run (ratio history gate)
	tests/bm/prev-pair-test = Synthetic-ledger test for prev-pair (cross-variant mispairing regression)
	tests/bm/sizemcode-tune-test = Tests bin/sizemcode-tune: JSON shape, remap flag, output-mismatch refusal, --match
	tests/compile/cross-targets = zig cc compile matrix for macOS (HRT/plain) and Windows mcode/callback allocators, -Werror
	tests/macos/hrt = macOS hardened-runtime (MAP_JIT) build, sign, JIT/callback/suite checks; runs on a Mac
	tests/macos/remote = Sync working tree to a Mac over ssh and run native + HRT checks there
	tests/mdwe/embed_fork.c = C harness: fork/raw clone while another thread compiles; child checks its code bytes
	tests/mdwe/embed_stress.c = C harness: 8-thread multi-lua_State JIT stress with -joff cross-check
	tests/mdwe/exec_bench.c = Executes identical code from anon vs memfd private/shared RX pages (icache cost of backing)
	tests/mdwe/flip_bench.c = Per-round cost of mprotect vs MAP_FIXED remap vs dual-alias code updates
	tests/mdwe/lua/cross_area.lua = T4: side traces patching parents in other mcode areas
	tests/mdwe/lua/ffi_callback.lua = Exercises FFI callback trampoline page via qsort
	tests/mdwe/lua/ffi_callback_pcall.lua = FFI callback must work or raise a catchable error, never SIGSEGV
	tests/mdwe/lua/fork_flush.lua = T5b: parent flush while child executes pre-fork traces
	tests/mdwe/lua/fork_isolation.lua = T5a/e/T11: fork isolation, seal at fork, re-home, callbacks
	tests/mdwe/lua/jit_smoke.lua = Forces trace compilation and reports trace count
	tests/mdwe/lua/maps_audit.lua = T6/P2: no writable mcode memfd mapping outside compile windows
	tests/mdwe/lua/mdwe_ffi.lua = FFI helpers for fork/seal tests (memfd info, pipes, trace snapshots)
	tests/mdwe/lua/trace_churn.lua = Deterministic compile-heavy workload counting compiled/aborted traces
	tests/mdwe/mdwe_exec.c = Launcher applying kernel PR_SET_MDWE before exec
	tests/mdwe/r_mode = Acceptance tests T1-T11 for the memfd allocator; 'runtime' arg drives a default build with -Omcoderemap=1
	tests/mdwe/run = MDWE characterization suite across none/kernel/seccomp/systemd surfaces
	tests/mdwe/sdmdwe_seccomp_exec.c = Launcher replicating systemd's seccomp MemoryDenyWriteExecute fallback filter
	tests/mdwe/wx_probe.c = W^X strategy probe (mprotect, RWX, memfd dual/remap, procmem, fork isolation)
	tests/upstream-suite = Runs pinned LuaJIT-test-cleanup suite; requires exact upstream baseline failure set
	tests/zig/arm64-qemu = Emulated arm64 (static musl under qemu-user) suite + checksum check
	tests/zig/compare-generated = Differential test: build.zig vs Makefile generated files across 5 targets
	tests/zig/host-interp = Checks the host build requests the host's ELF interpreter (stock NixOS without nix-ld)
]
