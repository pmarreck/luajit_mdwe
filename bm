#!/usr/bin/env bash
# Benchmark the fork (src/luajit, built from the working tree) against pinned
# upstream LuaJIT (flake input luajit-upstream), both built here with the same
# dev-shell toolchain and flags. Verifies identical stdout per benchmark, times
# both with hyperfine, appends rows to bench/<machine-id>.ndjson and flags
# changes beyond measured noise in EITHER direction:
#   - fork vs upstream in this run, and
#   - each variant vs its previous row on this machine.
# Robust statistics: median and sigma_r = 1.4826*MAD over the per-run times, so
# one-off stalls from other load do not dominate. A difference counts only if
# |delta median| > 3*sqrt(ra^2+rb^2) and > MIN_PCT.
#
# Usage: nix develop -c ./bm [--runs N] [--only name] [--no-log]
# BM_FORK_FLAGS (e.g. "-joff") is passed to the fork only; it exists to prove
# the gate trips on a real slowdown (use with --no-log).
# Runs inside a memory-capped systemd --user scope when available.
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runs=20 only="" log=1
MIN_PCT="${MIN_PCT:-3}"
while [ $# -gt 0 ]; do
	case "$1" in
		--runs) runs="$2"; shift ;;
		--only) only="$2"; shift ;;
		--no-log) log=0 ;;
		-h|--help) sed -n '2,13p' "$0"; exit 0 ;;
		*) echo "bm: unknown argument $1" >&2; exit 2 ;;
	esac
	shift
done

# Re-exec under a memory cap so a runaway benchmark cannot take the machine down.
if [ -z "${BM_CAPPED:-}" ] && command -v systemd-run >/dev/null &&
	systemd-run --user --quiet --scope true >/dev/null 2>&1; then
	exec systemd-run --user --quiet --scope -p MemoryMax=4G -p TasksMax=64 \
		env BM_CAPPED=1 "$0" --runs "$runs" ${only:+--only "$only"} $([ "$log" = 0 ] && echo --no-log)
fi

[ -n "${LUAJIT_TEST_CLEANUP:-}" ] || { echo "bm: run inside 'nix develop' (LUAJIT_TEST_CLEANUP unset)" >&2; exit 2; }
for t in hyperfine jq; do command -v $t >/dev/null || { echo "bm: $t missing" >&2; exit 2; }; done

work="$root/.build-work/bm"
mkdir -p "$work" "$root/bench"

# Build both binaries with identical toolchain/flags.
up_src="$(nix eval --raw "$root#packages.$(uname -m)-linux.luajit-upstream.src.outPath" 2>/dev/null)"
[ -d "$up_src" ] || { echo "bm: cannot resolve luajit-upstream source" >&2; exit 2; }
# One build directory per pinned upstream source; nothing is deleted.
updir="$work/upstream-$(basename "$up_src" | cut -c1-12)"
if [ ! -x "$updir/src/luajit" ]; then
	[ -d "$updir" ] || { cp -r "$up_src" "$updir" && chmod -R u+w "$updir"; }
	make -s -C "$updir/src" -j16 BUILDMODE=static >"$updir.make.log" 2>&1 ||
		{ echo "bm: upstream build failed (see $updir.make.log)" >&2; exit 1; }
fi
make -s -C "$root/src" -j16 BUILDMODE=static >"$work/fork-make.log" 2>&1 ||
	{ echo "bm: fork build failed (see $work/fork-make.log)" >&2; exit 1; }
fork="$root/src/luajit" up="$updir/src/luajit"
for b in "$fork" "$up"; do
	if "$b" -e 'os.exit(0)' 2>&1 | grep -q "DEBUG BUILD"; then echo "bm: debug build refused: $b" >&2; exit 2; fi
done

machine="$(printf '%s|%s|%s' "$(hostname)" "$(uname -m)" "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2)" | sha256sum | cut -c1-12)"
ledger="$root/bench/$machine.ndjson"
commit="$(git -C "$root" rev-parse --short=12 HEAD)"
dirty="$(git -C "$root" status --porcelain -- src | grep -q . && echo true || echo false)"
bench="$LUAJIT_TEST_CLEANUP/bench"

# name args (sized for ~0.1-0.8 s on the reference machine)
cases=(
	"array3d 200" "binary-trees 14" "fannkuch 10" "fasta 1e6" "mandelbrot 1000"
	"md5 2000" "nbody 5e5" "nsieve 9" "ray 4" "recursive-fib 32" "scimark-fft 5000"
	"scimark-lu 500" "scimark-sor 5000" "scimark-sparse 15e3" "series 3000"
	"spectral-norm 1000" "pidigits-nogmp 1000" "coroutine-ring 5e6" "life"
	"trace_churn 200"
)

flags=0
# robust VARIANT JSON -> "median sigma_r" of that command's per-run times
robust() {
	jq -r --arg v "$1" '.results[]|select(.command==$v)|.times|sort as $t|($t|length) as $n
		|def med: if length%2==1 then .[(length-1)/2] else (.[length/2-1]+.[length/2])/2 end;
		($t|med) as $m|"\($m) \([$t[]|(.-$m)|if .<0 then -. else . end]|sort|med*1.4826)"' "$2"
}
noise_check() {  # label mean_a sd_a mean_b sd_b -> prints verdict, bumps flags
	local label="$1" v info="${6:-}"
	v="$(awk -v a="$2" -v sa="$3" -v b="$4" -v sb="$5" -v p="$MIN_PCT" 'BEGIN{
		d=b-a; ad=d<0?-d:d; thr=3*sqrt(sa*sa+sb*sb); pct=100*d/a
		printf "%s %+.1f%% (3σ=%.1f%%)", (ad>thr && (pct>p||pct<-p)) ? "CHANGED" : "same", pct, 100*thr/a}')"
	if [ -n "$info" ]; then printf '  \e[2m%s: %s (informational)\e[0m\n' "$label" "$v"; return; fi
	case "$v" in CHANGED*) flags=$((flags+1)); printf '  \e[33;1m%s: %s\e[0m\n' "$label" "$v" ;; *) printf '  %s: %s\n' "$label" "$v" ;; esac
}

for c in "${cases[@]}"; do
	set -- $c; name="$1"; arg="${2:-}"
	[ -n "$only" ] && [ "$only" != "$name" ] && continue
	if [ "$name" = trace_churn ]; then script="$root/tests/mdwe/lua/trace_churn.lua"; else script="$bench/$name.lua"; fi
	# Correctness first: identical output from both builds. Hashed because some
	# benchmarks emit binary (mandelbrot PBM); nondeterministic fields removed:
	# trace_churn trace counts (PRNG-dependent) and series' self-reported timing.
	norm() { LC_ALL=C sed -E 's/compiled=[0-9]+ aborted=[0-9]+ //; s/, [0-9.]+ s, [0-9.]+ iterations\/s//' | sha256sum; }
	of="$(cd "$bench" && "$fork" ${BM_FORK_FLAGS:-} "$script" $arg 2>&1 | norm)"
	ou="$(cd "$bench" && "$up" "$script" $arg 2>&1 | norm)"
	if [ "$of" != "$ou" ]; then printf '\e[31mOUTPUT MISMATCH\e[0m %s\n' "$name"; flags=$((flags+1)); continue; fi
	json="$work/$name.json"
	# ABBA ordering: hyperfine runs each command's samples as one block, so a
	# load or frequency shift during one block would bias the comparison
	# (observed: batch-level 45% swings in user time on a shared machine).
	half=$(( (runs + 1) / 2 ))
	(cd "$bench" &&
		hyperfine -N --warmup 2 --runs "$half" --export-json "$json.ab" \
			-n fork "$fork ${BM_FORK_FLAGS:-} $script $arg" -n upstream "$up $script $arg" >/dev/null 2>&1 &&
		hyperfine -N --warmup 2 --runs "$half" --export-json "$json.ba" \
			-n upstream "$up $script $arg" -n fork "$fork ${BM_FORK_FLAGS:-} $script $arg" >/dev/null 2>&1) ||
		{ printf '\e[31mHYPERFINE FAILED\e[0m %s\n' "$name"; flags=$((flags+1)); continue; }
	# Pool both halves per command; per-run user/system are averaged.
	jq -s '{results: ([.[].results[]] | group_by(.command) | map({
		command: .[0].command, times: (map(.times[]) ),
		user: (map(.user) | add / length), system: (map(.system) | add / length)})
		| map(. + {mean: (.times | add / length),
			stddev: ((.times | add / length) as $m | (.times | map((. - $m) * (. - $m)) | add / (length - 1)) | sqrt),
			median: (.times | sort | if length % 2 == 1 then .[(length - 1) / 2] else (.[length / 2 - 1] + .[length / 2]) / 2 end)}))}' \
		"$json.ab" "$json.ba" >"$json"
	echo "$name $arg"
	read -r fm fs < <(robust fork "$json")
	read -r um us < <(robust upstream "$json")
	noise_check "fork vs upstream" "$um" "$us" "$fm" "$fs"
	# History gate on the fork/upstream RATIO: the unchanged upstream control
	# cancels machine drift between runs (load, frequency), which raw per-variant
	# history cannot. Raw history is still printed, informationally.
	pf="$(grep "\"bench\":\"$name\",\"variant\":\"fork\"" "$ledger" 2>/dev/null | tail -1)"
	pu="$(grep "\"bench\":\"$name\",\"variant\":\"upstream\"" "$ledger" 2>/dev/null | tail -1)"
	if [ -n "$pf" ] && [ -n "$pu" ]; then
		read -r r0 s0 r1 s1 < <(awk -v f0="$(jq -r .median_s <<<"$pf")" -v sf0="$(jq -r '.mad_sigma_s // .stddev_s' <<<"$pf")" \
			-v u0="$(jq -r .median_s <<<"$pu")" -v su0="$(jq -r '.mad_sigma_s // .stddev_s' <<<"$pu")" \
			-v f1="$fm" -v sf1="$fs" -v u1="$um" -v su1="$us" 'BEGIN{
			r0=f0/u0; r1=f1/u1
			print r0, r0*sqrt((sf0/f0)^2+(su0/u0)^2), r1, r1*sqrt((sf1/f1)^2+(su1/u1)^2)}')
		noise_check "fork/upstream ratio vs last ($(jq -r .commit <<<"$pf"))" "$r0" "$s0" "$r1" "$s1"
	fi
	for v in fork upstream; do
		prev="$(grep "\"bench\":\"$name\",\"variant\":\"$v\"" "$ledger" 2>/dev/null | tail -1)"
		read -r m s < <(robust "$v" "$json")
		if [ -n "$prev" ]; then
			noise_check "$v vs last ($(jq -r .commit <<<"$prev"))" "$(jq -r .median_s <<<"$prev")" "$(jq -r '.mad_sigma_s // .stddev_s' <<<"$prev")" "$m" "$s" info
		fi
		[ "$log" = 1 ] && jq -c --arg ts "$(date -Iseconds)" --arg commit "$commit" --argjson dirty "$dirty" \
			--arg bench "$name" --arg v "$v" --arg arg "$arg" --arg machine "$machine" \
			'.results[]|select(.command==$v)|{ts:$ts,machine:$machine,commit:$commit,dirty:$dirty,bench:$bench,variant:$v,arg:$arg,runs:(.times|length),mean_s:.mean,stddev_s:.stddev,median_s:.median,mad_sigma_s:(.times|sort as $t|($t|length) as $n|(if $n%2==1 then $t[($n-1)/2] else ($t[$n/2-1]+$t[$n/2])/2 end) as $m|[$t[]|(.-$m)|if .<0 then -. else . end]|sort|(if $n%2==1 then .[($n-1)/2] else (.[$n/2-1]+.[$n/2])/2 end)*1.4826),user_s:.user,system_s:.system}' \
			"$json" >>"$ledger"
	done
done

if [ "$flags" -gt 0 ]; then
	printf '\e[33;1mbm: %d change(s) beyond measured noise; review before accepting (rerunning records acceptance).\e[0m\n' "$flags"
	exit 1
fi
echo "bm: no changes beyond measured noise"
